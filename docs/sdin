				m.Children = append(m.Children, sdin.NewNode("Type", "email"))
				for _, t := range n.FormValues().Children {
					m.Children = append(m.Children, sdin.NewNode("To", t))
				}
				m.Children = append(m.Children, n.FormFields().Children...)
				notify.Children[i] = m

			case "slack":
				if k := len(n.FormValues().Children); k != 1 {
					fmt.Printf("Error: Got %d unnamed args for slack() at alert.sdin:%d, want 1.\n", k, n.Line)
					os.Exit(1)
				}
				m := sdin.NewNode("", sdin.TStruct())
				m.Children = append(m.Children, sdin.NewNode("Type", "slack"))
				for _, t := range n.FormValues().Children {
					m.Children = append(m.Children, sdin.NewNode("Channel", t))
				}
				m.Children = append(m.Children, n.FormFields().Children...)
				notify.Children[i] = m

			case "pagerduty":
