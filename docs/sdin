⁰	...
	for _, g := range root.Children {
³		g.Value = sdin.TFlatStruct() // same as sdin.MakeTokenFromRepr(":{")
⁰		if members := g.Get("Data.Members"); members != nil {
³			members.Value = sdin.TFlatList() // same as sdin.MakeTokenFromRepr(":[")
⁰			...
⁰		}
⁰	}
