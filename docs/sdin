The `deref()` function is a bit long, but it's mostly error handling:

```
func deref(n *sdin.Node) (*sdin.Node, error) {
	if n.Kind().FormName() != "ref" { return n, nil }
⁰	if len(n.Children) != 2 || n.Children[0].Name != "" || n.Children[1].Name != "" { return nil, fmt.Errorf("emailpw.InvalidRefSyntax: the correct form is ref('filename' sdinpath)") }
	filename, err := n.Children[0].As[string]()
⁰	if err != nil { return nil, fmt.Errorf("emailpw.InvalidRefFile: %v", err) }
	nodePath, err := n.Children[1].As[sdin.BareToken]()
⁰	if err != nil { return nil, fmt.Errorf("emailpw.ParseRefPath: %v", err) }
	f, err := os.ReadFile(filename)
⁰	if err != nil { return nil, fmt.Errorf("emailpw.ReadRefFile filename=%s: %v", filename, err) }
	m, err := sdin.Unmarshal[*sdin.Node](string(f))
⁰	if err != nil { return nil, fmt.Errorf("emailpw.ParseRefFile filename=%s: %v", filename, err) }
	r := m.Get(string(nodePath))
⁰	if r == nil { return nil, fmt.Errorf("emailpw.RefPathNotFound filename=%s path=%s", filename, string(nodePath)) }
	return sdin.NewNode(n.Name, r), nil // return a deep copy
}
```

